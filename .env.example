# Required: GitHub personal access token with read access to the target repos
GITHUB_TOKEN=

# Optional: only needed for the narrative endpoint
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Interface to listen on; set HOST=0.0.0.0 to listen on all interfaces
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/tempo.db
SYNC_TTL_MINUTES=15
# GitHub requests one sync run may make: pages, review follow-up pages and retries all count
SYNC_MAX_PAGES=40
SYNC_MAX_SECONDS=25
# New (uncached) narratives allowed per rolling hour across all clients; each one is a model call
NARRATIVE_MAX_PER_HOUR=30
# New narratives one client address (IPv6 by /64) may cause per rolling hour, within the shared budget above
NARRATIVE_MAX_PER_CLIENT_PER_HOUR=10
LOG_LEVEL=info

# Host names (any port) the server answers to, comma-separated; add the public name when HOST=0.0.0.0
ALLOWED_HOSTS=localhost,127.0.0.1
# Proxies trusted to set X-Forwarded-For and X-Forwarded-Host: false (no proxy), a hop count such as 1, or proxy
# addresses and CIDRs such as 10.0.0.0/8. The proxy must overwrite, not append to, both headers. Never use true.
TRUST_PROXY=false
